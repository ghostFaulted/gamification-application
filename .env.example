POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gamification
# Host-side port only; inside Compose Postgres always listens on 5432.
POSTGRES_PORT=5432
# Host "database" resolves only inside the Compose network.
DATABASE_URL=postgresql://postgres:postgres@database:5432/gamification
API_PORT=3000
WEB_PORT=5173
# Passed into the api service via Compose.
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_EXPIRES_IN_SECONDS=28800

# Local OpenLDAP (SCRUM-48). Plain LDAP on the Compose network; faculty LABS uses LDAPS.
# Host-side port only; inside Compose OpenLDAP listens on 389.
LDAP_PORT=389
LDAP_ADMIN_PASSWORD=admin
LDAP_CONFIG_PASSWORD=config
# Passed into the api service via Compose (SCRUM-49+). From the host use ldap://localhost:${LDAP_PORT}.
LDAP_URL=ldap://ldap:389
LDAP_BASE_DN=dc=labs,dc=wmi,dc=amu,dc=edu,dc=pl
LDAP_ADMIN_DN=cn=admin,dc=labs,dc=wmi,dc=amu,dc=edu,dc=pl
# The API accepts only ldaps:// unless this is true. Set to true ONLY for the local plain-LDAP container.
LDAP_ALLOW_INSECURE=true
# Attribute holding the login: uid for local OpenLDAP; Active Directory usually uses sAMAccountName.
LDAP_LOGIN_ATTRIBUTE=uid
LDAP_TIMEOUT_MS=5000
# Optional PEM file with the CA that signed the LDAPS server certificate (path inside the api container).
# LDAP_TLS_CA_FILE=/run/secrets/ldap-ca.pem
