# Seed data for local OpenLDAP (SCRUM-48).
# Base DN is created by osixia from LDAP_DOMAIN=labs.wmi.amu.edu.pl:
#   dc=labs,dc=wmi,dc=amu,dc=edu,dc=pl
# Shape mirrors faculty LABS (OU=People / OU=Groups, memberOf-style groups).
# Passwords match logins (student1, lecturer1, admin1, ...).

dn: ou=People,dc=labs,dc=wmi,dc=amu,dc=edu,dc=pl
objectClass: organizationalUnit
ou: People

dn: ou=Students,ou=People,dc=labs,dc=wmi,dc=amu,dc=edu,dc=pl
objectClass: organizationalUnit
ou: Students

